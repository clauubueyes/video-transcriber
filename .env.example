# Token necesario para usar la API propia. Sustituir en cada entorno.
VIDEO_TRANSCRIBER_TOKEN=replace-with-a-long-secret

# Parámetros que se utilizarán al incorporar trabajos y transcripción.
VIDEO_TRANSCRIBER_ALLOWED_DOMAINS=youtube.com,www.youtube.com,youtu.be
VIDEO_TRANSCRIBER_MAX_DURATION_SECONDS=3600
VIDEO_TRANSCRIBER_RESULT_TTL_SECONDS=86400
VIDEO_TRANSCRIBER_MAX_CONCURRENT_JOBS=1
# Máximo total de trabajos en cola y en curso; rechaza nuevos con HTTP 503.
VIDEO_TRANSCRIBER_MAX_PENDING_JOBS=10
VIDEO_TRANSCRIBER_DATABASE_PATH=data/transcriber.sqlite3
VIDEO_TRANSCRIBER_WORKER_POLL_INTERVAL_SECONDS=2
VIDEO_TRANSCRIBER_STALE_JOB_TIMEOUT_SECONDS=7200
VIDEO_TRANSCRIBER_PROCESS_JOBS_IN_API=true
# Interfaz web pública: visitantes sin token, cuotas global e individual.
VIDEO_TRANSCRIBER_PUBLIC_WEB_ENABLED=true
VIDEO_TRANSCRIBER_PUBLIC_JOBS_PER_HOUR=30
VIDEO_TRANSCRIBER_MAX_JOBS_PER_TOKEN=10
VIDEO_TRANSCRIBER_RATE_LIMIT_WINDOW_SECONDS=3600
VIDEO_TRANSCRIBER_MAX_UPLOAD_BYTES=500000000
VIDEO_TRANSCRIBER_TEMPORARY_DIRECTORY=tmp
VIDEO_TRANSCRIBER_ORPHAN_UPLOAD_AGE_SECONDS=3600

# Ruta de un modelo faster-whisper ya instalado localmente. No se descarga solo.
VIDEO_TRANSCRIBER_MODEL_PATH=models/whisper-small
VIDEO_TRANSCRIBER_WHISPER_DEVICE=cpu
VIDEO_TRANSCRIBER_WHISPER_COMPUTE_TYPE=int8
VIDEO_TRANSCRIBER_WHISPER_CPU_THREADS=2
# 5 mantiene la búsqueda habitual; 1 es más rápido, puede perder precisión.
VIDEO_TRANSCRIBER_WHISPER_BEAM_SIZE=5

# (Opcional) Clave de Groq API para transcripción gratuita ultrarrápida (0€/mes servidor).
# VIDEO_TRANSCRIBER_GROQ_API_KEY=gsk_...
# VIDEO_TRANSCRIBER_GROQ_MODEL=whisper-large-v3-turbo
# Extracción opcional de recetas desde una transcripción completada.
# Reutiliza GROQ_API_KEY; esta clave independiente es opcional y privada.
# VIDEO_TRANSCRIBER_RECIPE_API_KEY=gsk_...
VIDEO_TRANSCRIBER_RECIPE_EXTRACTION_ENABLED=true
VIDEO_TRANSCRIBER_RECIPE_MODEL=openai/gpt-oss-20b
VIDEO_TRANSCRIBER_RECIPE_TIMEOUT_SECONDS=90
VIDEO_TRANSCRIBER_RECIPE_MAX_TRANSCRIPT_CHARS=120000
VIDEO_TRANSCRIBER_RECIPE_JOBS_PER_HOUR=30
# Archivos grandes: FLAC mono 16 kHz, bloques secuenciales de hasta 10 minutos.
VIDEO_TRANSCRIBER_GROQ_CHUNK_SECONDS=600
VIDEO_TRANSCRIBER_GROQ_TIMEOUT_SECONDS=120

# Cookies opcionales de YouTube (formato Netscape). Mantener fuera del repositorio.
# VIDEO_TRANSCRIBER_YOUTUBE_COOKIE_FILE=/etc/secrets/youtube-cookies.txt

# Docker incluye el proveedor automático de PO Tokens y estos clientes.
# Para ejecución sin Docker, instalar y compilar el servidor bgutil 2.0.1.
# VIDEO_TRANSCRIBER_YOUTUBE_PLAYER_CLIENTS=mweb,tv,web_safari
# VIDEO_TRANSCRIBER_YOUTUBE_PO_TOKEN_SERVER_HOME=/ruta/bgutil/server
# (Opcional) Perfil HTTP/TLS de navegador; Docker usa Chrome mediante curl-cffi.
# VIDEO_TRANSCRIBER_YOUTUBE_IMPERSONATE=chrome
# Solicitar tokens también para las consultas iniciales (Docker usa always).
# VIDEO_TRANSCRIBER_YOUTUBE_PO_TOKEN_POLICY=always
# Docker mantiene el generador HTTP en localhost. Para un proveedor ya arrancado:
# VIDEO_TRANSCRIBER_YOUTUBE_PO_TOKEN_BASE_URL=http://127.0.0.1:4416
# Salida de red opcional si YouTube rechaza la IP de Render. Mantener en secreto.
# VIDEO_TRANSCRIBER_YOUTUBE_PROXY_URL=http://usuario:clave@host:puerto

# Runtime configurable (por ejemplo node en contenedores con poca RAM).
# VIDEO_TRANSCRIBER_YOUTUBE_JS_RUNTIMES=node
# JSON privado de sing-box/WireGuard. Solo se activa si se configura.
# Registrar el dispositivo WARP y aceptar sus condiciones antes de usarlo.
# VIDEO_TRANSCRIBER_YOUTUBE_WARP_CONFIG={...}
# Para WARP en Render Free: mweb, política auto y generador bajo demanda.
# VIDEO_TRANSCRIBER_YOUTUBE_PO_TOKEN_MODE=script
