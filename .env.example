# Token necesario para usar la API propia. Sustituir en cada entorno.
VIDEO_TRANSCRIBER_TOKEN=replace-with-a-long-secret

# Parámetros que se utilizarán al incorporar trabajos y transcripción.
VIDEO_TRANSCRIBER_ALLOWED_DOMAINS=youtube.com,www.youtube.com,youtu.be
VIDEO_TRANSCRIBER_MAX_DURATION_SECONDS=1800
VIDEO_TRANSCRIBER_RESULT_TTL_SECONDS=86400
VIDEO_TRANSCRIBER_MAX_CONCURRENT_JOBS=1
VIDEO_TRANSCRIBER_DATABASE_PATH=data/transcriber.sqlite3
VIDEO_TRANSCRIBER_WORKER_POLL_INTERVAL_SECONDS=2
VIDEO_TRANSCRIBER_PROCESS_JOBS_IN_API=true

# Ruta de un modelo faster-whisper ya instalado localmente. No se descarga solo.
VIDEO_TRANSCRIBER_MODEL_PATH=models/whisper-small
VIDEO_TRANSCRIBER_WHISPER_DEVICE=cpu
VIDEO_TRANSCRIBER_WHISPER_COMPUTE_TYPE=int8
